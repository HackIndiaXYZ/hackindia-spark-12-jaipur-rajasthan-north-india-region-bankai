# AquaSentinel Backend Environment Configuration

PROJECT_NAME="AquaSentinel Water Monitoring API"
VERSION="1.0.0"
API_V1_STR="/api"
DEBUG=True

# Database Configuration
# Uses SQLite as fallback if DATABASE_URL is not set or points to sqlite
DATABASE_URL="sqlite:///./aquasentinel.db"
# Example PostgreSQL URL: postgresql://user:password@localhost:5432/aquasentinel

# External Government Data API Keys (Optional/Placeholders)
NWIC_API_KEY=""
DATA_GOV_IN_API_KEY=""

# AI Reasoning LLM Configuration
LLM_PROVIDER="openai" # or mock / anthropic / gemini
LLM_API_KEY=""
LLM_MODEL="gpt-4o-mini"
